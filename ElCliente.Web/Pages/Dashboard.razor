@page "/dashboard/{CustomerId:int}"
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IRepository repository

<PageTitle>Dashboard</PageTitle>

@if (Registrations is null)
{
    <div class="spinner" />
}
else
{
        <div class="card">
        <div class="card-header">
            <span>
                <i class="oi oi-globe"></i> Mi Saldo
            </span>
        </div>
        <div class="card-body">
                @((MarkupString)$"{String.Format("{0:C}", balanceDTO.Amount)}")
        </div>
    </div>

    <br>
    <div class="card">
        <div class="card-header">
            <span>
                <i class="oi oi-globe"></i> Mis Productos
                    <a class="btn btn-sm btn-primary float-end" href="/registration/create/@CustomerId"><i class="oi oi-arrow-circle-left" /> Nueva Afiliación</a>
            </span>
        </div>
        <div class="card-body">
            @if (Registrations.Count > 0)
            {
                            <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPageAsync" />

            <GenericList MyList="Registrations">
                <Body>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Identificador</th>
                                <th>Producto</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var regis in Registrations!)
                            {
                                <tr>
                                    <td>
                                        @regis.Identifier
                                    </td>
                                    <td>
                                        @regis.Product.Name
                                    </td>
                                    <td>
                                        @{
                                            string status = regis.IsActive ? "Vigente" : "Cancelado";
                                        }
                                        @((MarkupString)status)
                                    </td>
                                    <td>
                                        @if (regis.IsActive)
                                            {
                                                 <button class="btn btn-danger fa" @onclick=@(() => CancellationsAsync(regis.Id, regis.Identifier!, regis.Product.Id))><i class="oi oi-trash" />Cancelar Suscripción</button>
                                            }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Body>
            </GenericList>
            }
            else
            {
                @((MarkupString)"No tiene productos registrados")
            }
        </div>
    </div>
}





