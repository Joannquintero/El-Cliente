@page "/registration/create/{CustomerId:int}"
@using El_Cliente.Shared.Entities
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<RegistrationsForm @ref="registrationsForm" RegistrationDTO="registrationDTO" Branchs="brands" OnValidSubmit="CreateAsync" ReturnAction="Return" />

@code {
    private RegistrationDTO registrationDTO = new();
    private CustomerContactDTO customerContactDTO = new();
    private BalanceDTO balanceDTO = new();
    private RegistrationsForm? registrationsForm;
    private List<BranchDTO> brands = new();

    [Parameter]
    public int CustomerId { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var httpResponse = await repository.Get<List<BranchDTO>>("/api/Branchs");
        foreach (var brand in httpResponse!.Response!)
        {
            brands.Add(new BranchDTO { Id = brand.Id, Name = brand.Name });
        }   
    }

    private async Task CreateAsync()
    {
        registrationDTO.CustomerId = CustomerId;
        var balanceResponse = await repository.Get<BalanceDTO>($"api/Balances/GetByCustomerIdAsync?customerId={registrationDTO.CustomerId}");
        var productResponse = await repository.Get<ProductDTO>($"api/Products/{registrationDTO.ProductId}");
        if (balanceResponse.Response!.Amount < productResponse.Response!.MinimumAmount)
        {
            await sweetAlertService.FireAsync($"No tiene saldo disponible para vincularse al fondo {productResponse.Response.Name}", null, SweetAlertIcon.Error);
            return;
        }

        registrationDTO.Identifier = Guid.NewGuid().ToString();
        var registrationResponse = await repository.Post<RegistrationDTO, RegistrationDTO>("api/Funds/OpeningAsync", registrationDTO);
        if (registrationResponse.Error)
        {
            var message = await registrationResponse.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        registrationDTO.Id = registrationResponse.Response!.Id;
        balanceDTO.Amount = balanceResponse.Response!.Amount - productResponse.Response!.MinimumAmount;
        balanceDTO.CustomerId = registrationDTO.CustomerId;
        var responseHttp = await repository.Put("/api/Balances", balanceDTO);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        Return();
    }

    private void Return()
    {
        registrationsForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo($"/dashboard/{CustomerId}");
    }
}
