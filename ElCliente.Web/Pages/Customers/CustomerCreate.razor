@page "/customer/create"
@using El_Cliente.Shared.Entities
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<CustomerForm @ref="customerForm" CustomerDTO="customerDTO" OnValidSubmit="CreateAsync" ReturnAction="Return" />

@code {
    private CustomerDTO customerDTO = new();
    private CustomerContactDTO customerContactDTO = new();
    private BalanceDTO balanceDTO = new();
    private CustomerForm? customerForm;

    private async Task CreateAsync()
    {
        // var customersResponse = await repository.Post("/api/Customers", customerDTO);
        var customersResponse = await repository.Post<CustomerDTO, CustomerDTO>("/api/Customers", customerDTO);
        customerDTO.Id = customersResponse.Response!.Id;
        if (customersResponse.Error)
        {
            var message = await customersResponse.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        if (!string.IsNullOrEmpty(customerDTO.Email))
        {
            customerContactDTO.Type = ContactTypeEnum.EMAIL.ToString();
            customerContactDTO.Value = customerDTO.Email;
            customerContactDTO.Notify = customerDTO.EmailCheck ? true : null;
        }

        if (!string.IsNullOrEmpty(customerDTO.Phone))
        {
            customerContactDTO.Type = ContactTypeEnum.PHONE.ToString();
            customerContactDTO.Value = customerDTO.Phone;
            customerContactDTO.Notify = customerDTO.SMSCheck ? true : null;
        }

        customerContactDTO.CustomerId = customerDTO.Id;
        var customerContactResponse = await repository.Post("/api/CustomerContact", customerContactDTO);
        if (customerContactResponse.Error)
        {
            var message = await customerContactResponse.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        // Se posee un monto inicial de COP $500.000.
        balanceDTO.Amount = 500000;
        balanceDTO.CustomerId = customerDTO.Id;
        var balancesResponse = await repository.Post("/api/Balances", balanceDTO);
        if (balancesResponse.Error)
        {
            var message = await balancesResponse.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        Return();
    }

    private void Return()
    {
        customerForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo($"/");
    }
}
